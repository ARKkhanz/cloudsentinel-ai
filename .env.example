# CloudSentinel AI — Environment Configuration
# Copy this file to .env for local overrides (never commit real secrets)

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (defaults to backend/data/cloudsentinel.db)
# DATABASE_URL=sqlite:///backend/data/cloudsentinel.db

# Frontend Configuration
# For local Vite development against local backend:
VITE_API_BASE_URL=http://localhost:8000
# For production / Docker Nginx reverse proxy (same-origin relative URLs):
# VITE_API_BASE_URL=""
