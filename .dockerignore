# CloudSentinel AI — Docker Build Ignore Rules
# Excludes unnecessary, local-development, and sensitive artifacts from Docker build context

# Version control
.git
.gitignore

# Environment configurations and secrets
.env
.env.*
*.env
!.env.example

# Python virtual environments and caches
.venv/
backend/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache/
**/.pytest_cache/

# SQLite databases and runtime journals
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
*.db
*.sqlite*

# Node / Frontend development dependencies and build outputs
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.eslintcache
**/.eslintcache
*.tsbuildinfo

# Logs and runtime debugging files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# QA artifacts, screenshots, and temporary media
screenshots/
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
.tempmediaStorage/
**/.tempmediaStorage/

# Editor and Operating System metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
